<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="createProductDialog"
        title="{dialogSettingsModel>/dialogTitle}"
        contentWidth="700px"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ColumnLayout"
                columnsM="2"
                columnsL="2"
                columnsXL="2"
            >
                <f:content>
                    <core:Title text="Informações do Produto" />

                    <Label
                        text="ID"
                        visible="{dialogSettingsModel>/isEditMode}"
                    />
                    <Input
                        visible="{dialogSettingsModel>/isEditMode}"
                        editable="false"
                        value="{createProduct>/Id}"
                    />

                    <Label text="Nome" />
                    <Input
                        value="{createProduct>/Nome}"
                        required="true"
                        maxLength="60"
                    />

                    <Label text="Descrição" />
                    <Input
                        value="{createProduct>/Descricao}"
                        maxLength="100"
                    />

                    <Label text="Categoria" />
                    <Select
                        enabled="true"
                        editable="true"
                        selectedKey="{createProduct>/Categoria}"
                    >
                        <core:Item
                            key="1"
                            text="Bebida Quente"
                        />
                        <core:Item
                            key="2"
                            text="Bebida Fria"
                        />
                        <core:Item
                            key="3"
                            text="Salgado"
                        />
                        <core:Item
                            key="4"
                            text="Sobremesa"
                        />
                        <core:Item
                            key="5"
                            text="Entrada"
                        />
                    </Select>

                    <Label text="Preço/Moeda" />
                    <Input
                        type="Number"
                        value="{createProduct>/Preco}"
                        description="BRL"
                        change="onPrecoChange"
                    />

                    <Label text="Unidade" />
                    <Select enabled="true"
                        editable="true"
                        selectedKey="{createProduct>/Unidade}"
                        items="{unidades>/items}"
                    >
                        <core:Item
                            key="{unidades>key}"
                            text="{unidades>text}"
                        />
                    </Select>


                </f:content>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="{dialogSettingsModel>/buttonText}"
                type="Emphasized"
                press="onSaveProduct"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancelar"
                press="onCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
